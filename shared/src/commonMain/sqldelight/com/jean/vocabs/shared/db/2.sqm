-- Fase 2 — retenção ativa.
--
-- Aqui o ALTER TABLE basta, ao contrário do 1.sqm. Adicionar coluna com
-- NOT NULL + DEFAULT constante é justamente a alteração que o SQLite faz bem;
-- o que ele não sabe fazer é REMOVER um NOT NULL, que era o problema de lá.
--
-- ALTER TABLE anexa as colunas no fim da tabela — por isso elas também estão no
-- fim do CREATE TABLE em Vocabs.sq. Instalação nova e instalação migrada
-- precisam ter a mesma ordem de colunas.

ALTER TABLE entrada ADD COLUMN pontos REAL NOT NULL DEFAULT 100.0;
ALTER TABLE entrada ADD COLUMN taxa_decaimento REAL NOT NULL DEFAULT 40.0;
ALTER TABLE entrada ADD COLUMN data_ultima_interacao INTEGER NOT NULL DEFAULT 0;
ALTER TABLE entrada ADD COLUMN revisoes INTEGER NOT NULL DEFAULT 0;

-- O que já existe começa a contar de criado_em, não de agora.
--
-- criado_em É a última interação real com a palavra: foi quando você digitou o
-- trecho e leu a ficha que chegou. Ancorar em "agora" deixaria a fila vazia por
-- um dia inteiro depois da atualização, dando a impressão de que o recurso não
-- funciona. Com criado_em, a fila já reflete na primeira abertura o que você de
-- fato esqueceu — inclusive palavras de meses atrás, que entram com 0 pontos.
-- O teto de cartões por sessão é o que impede isso de virar uma avalanche.
UPDATE entrada SET data_ultima_interacao = criado_em;

CREATE TABLE dia_revisado (
    dia      INTEGER NOT NULL PRIMARY KEY,
    revisoes INTEGER NOT NULL DEFAULT 0
);
