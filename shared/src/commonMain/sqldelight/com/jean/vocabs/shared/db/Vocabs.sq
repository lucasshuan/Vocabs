-- Uma tabela só. A ficha nasce sempre de exatamente uma captura, então separar
-- em duas tabelas com FK só adicionaria um JOIN sem ganho nenhum agora.
--
-- Fase 1.5: a mesma tabela guarda os três formatos de captura. Foto e áudio
-- entram como RASCUNHO, sem trecho nem alvo — eles só passam a existir quando
-- você transcreve. É por isso que essas duas colunas aceitam NULL.
CREATE TABLE entrada (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    trecho          TEXT,            -- NULL enquanto o rascunho não foi transcrito
    alvo            TEXT,            -- idem
    origem          TEXT,            -- jogo, livro, série... opcional
    criado_em       INTEGER NOT NULL,
    status          TEXT NOT NULL,   -- RASCUNHO | PENDENTE | GERANDO | PRONTA | ERRO
    formato         TEXT NOT NULL,   -- TEXTO | FOTO | AUDIO
    midia_caminho   TEXT,            -- arquivo local, quando formato != TEXTO
    tipo            TEXT,            -- PALAVRA | EXPRESSAO (vem da IA)
    traducao        TEXT,
    definicoes_json TEXT,            -- array JSON: 1-2 strings, nunca consultado por conteúdo
    exemplo         TEXT,
    ipa             TEXT,
    erro            TEXT,            -- mensagem quando status = ERRO

    -- Fase 2 — retenção. Dois números e não um: se todas as palavras caíssem no
    -- mesmo ritmo, uma dominada há meses sumiria tão rápido quanto uma nova —
    -- que é justamente a vantagem que a repetição espaçada existe para dar.
    --
    -- No fim da tabela de propósito: 2.sqm adiciona estas colunas com ALTER
    -- TABLE, que anexa no fim. Instalação nova e migrada precisam bater.
    pontos                REAL    NOT NULL DEFAULT 100.0,  -- 0-100, salvos na última resposta
    taxa_decaimento       REAL    NOT NULL DEFAULT 40.0,   -- pontos perdidos por dia
    data_ultima_interacao INTEGER NOT NULL DEFAULT 0,      -- 0 = ainda não virou ficha
    -- Distingue "nunca revisada" de "revisada". Sem isto, uma ficha recém-gerada
    -- nasce com 100 pontos e a tela a chamaria de "dominada" — mentira que
    -- desmoraliza o recurso inteiro no primeiro contato.
    revisoes              INTEGER NOT NULL DEFAULT 0,

    -- Placar por palavra, para a taxa de acerto da Fase 8.
    --
    -- Parecem redundantes com `revisoes`, e daqui para a frente são mesmo: toda
    -- resposta soma nos dois lugares. A diferença aparece no passado. As revisões
    -- feitas antes desta coluna existir não têm resultado guardado, e `acertos +
    -- erros` é justamente o total de que se sabe o desfecho — então a taxa sai
    -- calculada só sobre elas. Derivar `erros = revisoes - acertos` seria mais
    -- curto e contaria que toda revisão antiga foi um erro.
    acertos               INTEGER NOT NULL DEFAULT 0,
    erros                 INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX entrada_criado_em ON entrada(criado_em DESC);

-- Calendário de revisões: uma linha por dia local em que você respondeu ao menos
-- um cartão. É o mínimo para o critério de saída da fase ("7 dias seguidos") ser
-- verificável sozinho — sem trilha de eventos, sem tabela de sessões.
--
-- `dia` é um Julian Day Number local: vira à meia-noite do fuso do aparelho,
-- então dias seguidos diferem exatamente em 1 e a sequência vira uma subtração.
-- Nenhuma aritmética de calendário no Kotlin, que aqui não tem kotlinx-datetime.
CREATE TABLE dia_revisado (
    dia      INTEGER NOT NULL PRIMARY KEY,
    revisoes INTEGER NOT NULL DEFAULT 0
);

buscarPorId:
SELECT * FROM entrada WHERE id = ?;

-- A home mostra só o que virou ficha. Tudo que ainda está cru vive no inbox,
-- que é justamente a separação que a Fase 1.5 pede.
listarProntas:
SELECT * FROM entrada WHERE status = 'PRONTA' ORDER BY criado_em DESC;

-- Mais antigo primeiro: o que está parado há mais tempo é o que corre risco de
-- virar backlog esquecido.
listarInbox:
SELECT * FROM entrada WHERE status != 'PRONTA' ORDER BY criado_em ASC;

inserirCaptura:
INSERT INTO entrada (trecho, alvo, origem, criado_em, status, formato, midia_caminho)
VALUES (?, ?, ?, ?, ?, ?, ?);

ultimoIdInserido:
SELECT last_insert_rowid();

-- Fecha o ciclo do rascunho: a transcrição chega e a entrada entra na fila da IA.
transcrever:
UPDATE entrada SET trecho = ?, alvo = ?, origem = ?, status = ?, erro = NULL WHERE id = ?;

marcarStatus:
UPDATE entrada SET status = ?, erro = NULL WHERE id = ?;

salvarFicha:
UPDATE entrada
SET status = ?, tipo = ?, traducao = ?, definicoes_json = ?, exemplo = ?, ipa = ?, erro = NULL
WHERE id = ?;

marcarErro:
UPDATE entrada SET status = ?, erro = ? WHERE id = ?;

excluir:
DELETE FROM entrada WHERE id = ?;

-- Não existe uma query "listarFila". Os pontos atuais dependem de "agora", e um
-- Flow do SQLDelight só reemite quando a tabela muda, nunca quando o relógio
-- anda: um WHERE com o tempo dentro congelaria o "agora" no instante em que a
-- query foi montada, e a fila pararia sem dar erro nenhum. O filtro vive no
-- Kotlin, na mesma função pura que desenha a barra da ficha.

-- Os valores já chegam calculados pelo domínio.
salvarRetencao:
UPDATE entrada
SET pontos = ?, taxa_decaimento = ?, data_ultima_interacao = ?,
    revisoes = ?, acertos = ?, erros = ?
WHERE id = ?;

-- Único lugar onde a fronteira do dia é definida. 'localtime' usa o fuso do
-- aparelho; o + 0.5 desloca o Julian Day (que vira ao meio-dia) para virar à
-- meia-noite.
--
-- O `:instante + 0` não é enfeite: dentro de uma chamada de função o SQLDelight
-- não consegue inferir o tipo do parâmetro e o gera como String. A soma força o
-- contexto numérico e ele sai como Long.
diaLocal:
SELECT CAST(julianday((:instante + 0) / 1000, 'unixepoch', 'localtime') + 0.5 AS INTEGER);

-- Dois statements em vez de um UPSERT: `ON CONFLICT DO UPDATE` pede SQLite 3.24,
-- que só chegou no Android 10 (API 29). O minSdk daqui é 26, que traz o 3.19 —
-- um UPSERT compilaria, passaria no emulador moderno e quebraria num Android 8.
abrirDia:
INSERT OR IGNORE INTO dia_revisado (dia, revisoes) VALUES (?, 0);

somarRevisao:
UPDATE dia_revisado SET revisoes = revisoes + 1 WHERE dia = ?;

-- Do mais recente para trás; a sequência para no primeiro buraco. O teto é
-- folga: nenhuma sequência real precisa de mais de um ano de histórico.
listarDiasRevisados:
SELECT dia FROM dia_revisado ORDER BY dia DESC LIMIT 400;
