-- Uma captura guarda o contexto e a mídia. Várias entradas podem apontar para
-- ela, inclusive seleções sobrepostas do mesmo trecho.
--
-- O par de idiomas é dela, e não das entradas: um trecho está numa língua só, e
-- toda seleção dentro dele herda essa língua por construção.
CREATE TABLE captura (
    id                INTEGER PRIMARY KEY AUTOINCREMENT,
    trecho            TEXT,
    origem            TEXT,
    criado_em         INTEGER NOT NULL,
    status            TEXT NOT NULL, -- TRANSCREVENDO | AGUARDANDO_SELECAO | PROCESSADA
    formato           TEXT NOT NULL, -- TEXTO | FOTO | AUDIO
    midia_caminho     TEXT,
    duracao_ms        INTEGER,
    erro_transcricao  TEXT,
    idioma_nativo     TEXT NOT NULL DEFAULT 'pt-BR',
    idioma_alvo       TEXT NOT NULL DEFAULT 'en'
);

CREATE INDEX captura_criado_em ON captura(criado_em DESC);
CREATE INDEX captura_status ON captura(status);
CREATE INDEX captura_idioma ON captura(idioma_alvo, idioma_nativo);

-- Uma entrada é um alvo confirmado e, quando pronta, sua ficha e retenção.
CREATE TABLE entrada (
    id                      INTEGER PRIMARY KEY AUTOINCREMENT,
    captura_id              INTEGER NOT NULL REFERENCES captura(id) ON DELETE CASCADE,
    alvo                    TEXT NOT NULL,
    inicio                  INTEGER,
    fim                     INTEGER,
    tipo                    TEXT NOT NULL, -- PALAVRA | EXPRESSAO, decidido localmente
    status                  TEXT NOT NULL, -- PENDENTE | GERANDO | PRONTA | ERRO
    traducao                TEXT,
    definicoes_json         TEXT,
    exemplo                 TEXT,
    -- Na notação que o idioma alvo pede: IPA no inglês, pinyin no mandarim.
    pronuncia               TEXT,
    relacionadas_json       TEXT,
    erro                    TEXT,
    pontos                  REAL NOT NULL DEFAULT 100.0,
    taxa_decaimento         REAL NOT NULL DEFAULT 40.0,
    data_ultima_interacao   INTEGER NOT NULL DEFAULT 0,
    revisoes                INTEGER NOT NULL DEFAULT 0,
    acertos                 INTEGER NOT NULL DEFAULT 0,
    erros                   INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX entrada_captura ON entrada(captura_id);
CREATE INDEX entrada_status ON entrada(status);

CREATE VIEW entrada_com_captura AS
SELECT
    e.id,
    e.captura_id,
    e.alvo,
    e.inicio,
    e.fim,
    e.tipo,
    e.status,
    e.traducao,
    e.definicoes_json,
    e.exemplo,
    e.pronuncia,
    e.relacionadas_json,
    e.erro,
    e.pontos,
    e.taxa_decaimento,
    e.data_ultima_interacao,
    e.revisoes,
    e.acertos,
    e.erros,
    c.trecho,
    c.origem,
    c.criado_em,
    c.formato,
    c.midia_caminho,
    c.duracao_ms,
    c.idioma_nativo,
    c.idioma_alvo
FROM entrada e
JOIN captura c ON c.id = e.captura_id;

CREATE TABLE dia_revisado (
    dia      INTEGER NOT NULL PRIMARY KEY,
    revisoes INTEGER NOT NULL DEFAULT 0
);

-- O que aconteceu em cada dia, para a tela Dia a dia.
--
-- A retenção guarda só o estado de agora e responde "como está esta palavra";
-- não responde "o que eu fiz terça". Esta tabela é append-only e cada linha já
-- nasce com o dia local resolvido, na mesma escala de `dia_revisado`.
CREATE TABLE evento (
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    entrada_id INTEGER NOT NULL REFERENCES entrada(id) ON DELETE CASCADE,
    dia        INTEGER NOT NULL,
    instante   INTEGER NOT NULL,
    tipo       TEXT NOT NULL, -- CAPTURADA | FICHA_PRONTA | ACERTO | ERRO | SUBIU_NIVEL
    -- Número da revisão no ACERTO/ERRO, nível novo no SUBIU_NIVEL. Nulo no resto.
    detalhe    TEXT
);

CREATE INDEX evento_dia ON evento(dia DESC);
CREATE INDEX evento_entrada ON evento(entrada_id);

-- Contador local e informativo. Sem conta de usuário, ele não é uma quota de
-- segurança; registra apenas gerações concluídas pelo aparelho.
CREATE TABLE uso_ia (
    mes       TEXT NOT NULL PRIMARY KEY,
    geracoes  INTEGER NOT NULL DEFAULT 0
);

buscarEntradaPorId:
SELECT * FROM entrada_com_captura WHERE id = ?;

-- O punhado de entradas que a tela "Guardado" acompanha enquanto a IA trabalha.
listarEntradasPorIds:
SELECT * FROM entrada_com_captura WHERE id IN ? ORDER BY id;

listarProntas:
SELECT * FROM entrada_com_captura WHERE status = 'PRONTA' ORDER BY criado_em DESC;

listarInbox:
SELECT * FROM entrada_com_captura WHERE status != 'PRONTA' ORDER BY criado_em ASC;

listarTodasEntradas:
SELECT * FROM entrada_com_captura ORDER BY criado_em DESC, id DESC;

buscarCapturaPorId:
SELECT * FROM captura WHERE id = ?;

listarCapturasPendentes:
SELECT * FROM captura WHERE status != 'PROCESSADA' ORDER BY criado_em ASC;

listarTodasCapturas:
SELECT * FROM captura ORDER BY criado_em DESC;

inserirCaptura:
INSERT INTO captura (
    trecho, origem, criado_em, status, formato, midia_caminho, duracao_ms, erro_transcricao,
    idioma_nativo, idioma_alvo
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

ultimoIdInserido:
SELECT last_insert_rowid();

inserirEntrada:
INSERT INTO entrada (captura_id, alvo, inicio, fim, tipo, status)
VALUES (?, ?, ?, ?, ?, ?);

registrarTranscricao:
UPDATE captura
SET trecho = ?, status = 'AGUARDANDO_SELECAO', erro_transcricao = ?
WHERE id = ?;

processarCaptura:
UPDATE captura
SET trecho = ?, status = 'PROCESSADA', erro_transcricao = NULL
WHERE id = ?;

-- Só vale enquanto a captura não virou fichas: depois disso o par está gravado
-- em entradas que nasceram nele.
alterarIdiomaDaCaptura:
UPDATE captura SET idioma_alvo = ? WHERE id = ? AND status != 'PROCESSADA';

marcarStatus:
UPDATE entrada SET status = ?, erro = NULL WHERE id = ?;

salvarFicha:
UPDATE entrada
SET status = ?, tipo = ?, traducao = ?, definicoes_json = ?, exemplo = ?, pronuncia = ?,
    relacionadas_json = ?, erro = NULL
WHERE id = ?;

marcarErro:
UPDATE entrada SET status = ?, erro = ? WHERE id = ?;

excluirEntrada:
DELETE FROM entrada WHERE id = ?;

excluirEntradasDaCaptura:
DELETE FROM entrada WHERE captura_id = ?;

excluirCaptura:
DELETE FROM captura WHERE id = ?;

contarEntradasDaCaptura:
SELECT count(*) FROM entrada WHERE captura_id = ?;

listarIdsDaCaptura:
SELECT id FROM entrada WHERE captura_id = ? ORDER BY id;

salvarRetencao:
UPDATE entrada
SET pontos = ?, taxa_decaimento = ?, data_ultima_interacao = ?,
    revisoes = ?, acertos = ?, erros = ?
WHERE id = ?;

diaLocal:
SELECT CAST(julianday((:instante + 0) / 1000, 'unixepoch', 'localtime') + 0.5 AS INTEGER);

mesLocal:
SELECT strftime('%Y-%m', (:instante + 0) / 1000, 'unixepoch', 'localtime');

abrirDia:
INSERT OR IGNORE INTO dia_revisado (dia, revisoes) VALUES (?, 0);

somarRevisao:
UPDATE dia_revisado SET revisoes = revisoes + 1 WHERE dia = ?;

listarDiasRevisados:
SELECT dia FROM dia_revisado ORDER BY dia DESC LIMIT 400;

listarAtividadeDesde:
SELECT dia, revisoes FROM dia_revisado WHERE dia >= ? ORDER BY dia ASC;

abrirMesIa:
INSERT OR IGNORE INTO uso_ia (mes, geracoes) VALUES (?, 0);

somarGeracaoIa:
UPDATE uso_ia SET geracoes = geracoes + 1 WHERE mes = ?;

observarUsoIaDoMes:
SELECT geracoes FROM uso_ia WHERE mes = ?;

registrarEvento:
INSERT INTO evento (entrada_id, dia, instante, tipo, detalhe) VALUES (?, ?, ?, ?, ?);

-- A linha do tempo já sai com o alvo e o idioma do lado: a tela mostra a palavra,
-- não o id, e filtra pelo curso aberto.
listarEventosDesde:
SELECT
    ev.id,
    ev.entrada_id,
    ev.dia,
    ev.instante,
    ev.tipo,
    ev.detalhe,
    e.alvo,
    c.idioma_nativo,
    c.idioma_alvo
FROM evento ev
JOIN entrada e ON e.id = ev.entrada_id
JOIN captura c ON c.id = e.captura_id
WHERE ev.dia >= ?
ORDER BY ev.dia DESC, ev.instante DESC, ev.id DESC;
