-- Fase 1.5 — capturas de foto e áudio.
--
-- Duas mudanças: as colunas novas (formato, midia_caminho) e a perda do NOT NULL
-- em trecho/alvo, porque um rascunho de foto ainda não tem nenhum dos dois.
--
-- As colunas novas caberiam num ALTER TABLE, mas remover NOT NULL não: o SQLite
-- não sabe alterar a restrição de uma coluna existente. O caminho é recriar a
-- tabela e copiar os dados — o que também deixa a ordem das colunas idêntica à
-- do CREATE TABLE em Vocabs.sq, evitando que instalação nova e instalação
-- migrada divirjam.
--
-- As entradas que já existem são todas de texto, então formato = 'TEXTO'.

DROP INDEX entrada_criado_em;

ALTER TABLE entrada RENAME TO entrada_antiga;

CREATE TABLE entrada (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    trecho          TEXT,
    alvo            TEXT,
    origem          TEXT,
    criado_em       INTEGER NOT NULL,
    status          TEXT NOT NULL,
    formato         TEXT NOT NULL,
    midia_caminho   TEXT,
    tipo            TEXT,
    traducao        TEXT,
    definicoes_json TEXT,
    exemplo         TEXT,
    ipa             TEXT,
    erro            TEXT
);

INSERT INTO entrada (
    id, trecho, alvo, origem, criado_em, status, formato, midia_caminho,
    tipo, traducao, definicoes_json, exemplo, ipa, erro
)
SELECT
    id, trecho, alvo, origem, criado_em, status, 'TEXTO', NULL,
    tipo, traducao, definicoes_json, exemplo, ipa, erro
FROM entrada_antiga;

DROP TABLE entrada_antiga;

CREATE INDEX entrada_criado_em ON entrada(criado_em DESC);
