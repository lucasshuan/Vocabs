-- Três coisas: o par de idiomas de cada captura, `ipa` virando `pronuncia` e a
-- linha do tempo que a tela "Dia a dia" lê.
--
-- O par mora na **captura**, e não na entrada, porque é onde ele de fato nasce:
-- um trecho está numa língua só, e todas as seleções dentro dele herdam essa
-- língua por construção. Guardar nas duas pontas abriria a possibilidade de
-- discordarem, e não existe pergunta que a cópia responda mais rápido.

PRAGMA foreign_keys = 0;

ALTER TABLE captura ADD COLUMN idioma_nativo TEXT NOT NULL DEFAULT 'pt-BR';
ALTER TABLE captura ADD COLUMN idioma_alvo TEXT NOT NULL DEFAULT 'en';

CREATE INDEX captura_idioma ON captura(idioma_alvo, idioma_nativo);

-- `ipa` -> `pronuncia`: IPA não serve para mandarim nem japonês, e o campo passa
-- a carregar a notação que cada idioma pede. É uma reconstrução de tabela porque
-- ALTER TABLE ... RENAME COLUMN só existe no SQLite 3.25, e a API 26 tem 3.18.
DROP VIEW entrada_com_captura;

ALTER TABLE entrada RENAME TO entrada_com_ipa;

CREATE TABLE entrada (
    id                      INTEGER PRIMARY KEY AUTOINCREMENT,
    captura_id              INTEGER NOT NULL REFERENCES captura(id) ON DELETE CASCADE,
    alvo                    TEXT NOT NULL,
    inicio                  INTEGER,
    fim                     INTEGER,
    tipo                    TEXT NOT NULL,
    status                  TEXT NOT NULL,
    traducao                TEXT,
    definicoes_json         TEXT,
    exemplo                 TEXT,
    pronuncia               TEXT,
    relacionadas_json       TEXT,
    erro                    TEXT,
    pontos                  REAL NOT NULL DEFAULT 100.0,
    taxa_decaimento         REAL NOT NULL DEFAULT 40.0,
    data_ultima_interacao   INTEGER NOT NULL DEFAULT 0,
    revisoes                INTEGER NOT NULL DEFAULT 0,
    acertos                 INTEGER NOT NULL DEFAULT 0,
    erros                   INTEGER NOT NULL DEFAULT 0
);

INSERT INTO entrada (
    id, captura_id, alvo, inicio, fim, tipo, status,
    traducao, definicoes_json, exemplo, pronuncia, relacionadas_json, erro,
    pontos, taxa_decaimento, data_ultima_interacao, revisoes, acertos, erros
)
SELECT
    id, captura_id, alvo, inicio, fim, tipo, status,
    traducao, definicoes_json, exemplo, ipa, relacionadas_json, erro,
    pontos, taxa_decaimento, data_ultima_interacao, revisoes, acertos, erros
FROM entrada_com_ipa;

DROP TABLE entrada_com_ipa;

CREATE INDEX entrada_captura ON entrada(captura_id);
CREATE INDEX entrada_status ON entrada(status);

CREATE VIEW entrada_com_captura AS
SELECT
    e.id,
    e.captura_id,
    e.alvo,
    e.inicio,
    e.fim,
    e.tipo,
    e.status,
    e.traducao,
    e.definicoes_json,
    e.exemplo,
    e.pronuncia,
    e.relacionadas_json,
    e.erro,
    e.pontos,
    e.taxa_decaimento,
    e.data_ultima_interacao,
    e.revisoes,
    e.acertos,
    e.erros,
    c.trecho,
    c.origem,
    c.criado_em,
    c.formato,
    c.midia_caminho,
    c.duracao_ms,
    c.idioma_nativo,
    c.idioma_alvo
FROM entrada e
JOIN captura c ON c.id = e.captura_id;

-- O que aconteceu em cada dia.
--
-- A retenção guarda só o estado de agora — pontos, taxa e a última interação.
-- Isso responde "como está esta palavra" e não responde "o que eu fiz terça",
-- que é a pergunta inteira da tela Dia a dia. Daí uma tabela de eventos: ela é
-- append-only e cada linha já nasce com o dia local resolvido, na mesma escala
-- de `dia_revisado`, para a tela agrupar sem refazer contas de fuso.
CREATE TABLE evento (
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    entrada_id INTEGER NOT NULL REFERENCES entrada(id) ON DELETE CASCADE,
    dia        INTEGER NOT NULL,
    instante   INTEGER NOT NULL,
    tipo       TEXT NOT NULL, -- CAPTURADA | FICHA_PRONTA | ACERTO | ERRO | SUBIU_NIVEL
    -- Número da revisão no ACERTO/ERRO, nível novo no SUBIU_NIVEL. Nulo no resto.
    detalhe    TEXT
);

CREATE INDEX evento_dia ON evento(dia DESC);
CREATE INDEX evento_entrada ON evento(entrada_id);

-- Só CAPTURADA é reconstruível: a data de captura está guardada, e as revisões
-- antigas não estavam — o mesmo motivo pelo qual `acertos` e `erros` nasceram em
-- zero na migração 3. Inventar as respostas passadas encheria a linha do tempo
-- de coisas que talvez não tenham acontecido nesses dias.
INSERT INTO evento (entrada_id, dia, instante, tipo, detalhe)
SELECT
    e.id,
    CAST(julianday(c.criado_em / 1000, 'unixepoch', 'localtime') + 0.5 AS INTEGER),
    c.criado_em,
    'CAPTURADA',
    NULL
FROM entrada e
JOIN captura c ON c.id = e.captura_id;

PRAGMA foreign_keys = 1;
