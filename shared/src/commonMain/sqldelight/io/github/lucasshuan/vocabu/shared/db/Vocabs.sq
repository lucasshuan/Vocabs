-- Several entries can point at one capture, with overlapping selections.
--
-- The pair lives here, not on the entries: a snippet is in one language, so
-- every selection inside it inherits that language by construction.
CREATE TABLE capture (
    id                   INTEGER PRIMARY KEY AUTOINCREMENT,
    snippet              TEXT,
    source               TEXT,
    created_at           INTEGER NOT NULL,
    status               TEXT NOT NULL, -- TRANSCRIBING | AWAITING_SELECTION | PROCESSED
    format               TEXT NOT NULL, -- TEXT | PHOTO | AUDIO
    media_path           TEXT,
    duration_ms          INTEGER,
    transcription_error  TEXT,
    native_language      TEXT NOT NULL DEFAULT 'pt-BR',
    target_language      TEXT NOT NULL DEFAULT 'en'
);

CREATE INDEX capture_created_at ON capture(created_at DESC);
CREATE INDEX capture_status ON capture(status);
CREATE INDEX capture_language ON capture(target_language, native_language);

CREATE TABLE entry (
    id                   INTEGER PRIMARY KEY AUTOINCREMENT,
    capture_id           INTEGER NOT NULL REFERENCES capture(id) ON DELETE CASCADE,
    target               TEXT NOT NULL,
    start_index          INTEGER,
    end_index            INTEGER,
    type                 TEXT NOT NULL, -- WORD | PHRASE, decided on the device
    status               TEXT NOT NULL, -- PENDING | GENERATING | READY | ERROR
    translation          TEXT,
    definitions_json     TEXT,
    example              TEXT,
    -- Not `ipa`: IPA for English, pinyin for Mandarin.
    pronunciation        TEXT,
    related_json         TEXT,
    -- Split so the message localizes on the way out: the code picks a string
    -- resource, the detail carries the provider's untranslated text.
    error_code           TEXT,
    error_detail         TEXT,
    points               REAL NOT NULL DEFAULT 100.0,
    decay_rate           REAL NOT NULL DEFAULT 40.0,
    last_interaction_at  INTEGER NOT NULL DEFAULT 0,
    reviews              INTEGER NOT NULL DEFAULT 0,
    correct_count        INTEGER NOT NULL DEFAULT 0,
    incorrect_count      INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX entry_capture ON entry(capture_id);
CREATE INDEX entry_status ON entry(status);

CREATE VIEW entry_with_capture AS
SELECT
    e.id,
    e.capture_id,
    e.target,
    e.start_index,
    e.end_index,
    e.type,
    e.status,
    e.translation,
    e.definitions_json,
    e.example,
    e.pronunciation,
    e.related_json,
    e.error_code,
    e.error_detail,
    e.points,
    e.decay_rate,
    e.last_interaction_at,
    e.reviews,
    e.correct_count,
    e.incorrect_count,
    c.snippet,
    c.source,
    c.created_at,
    c.format,
    c.media_path,
    c.duration_ms,
    c.native_language,
    c.target_language
FROM entry e
JOIN capture c ON c.id = e.capture_id;

CREATE TABLE reviewed_day (
    day      INTEGER NOT NULL PRIMARY KEY,
    reviews  INTEGER NOT NULL DEFAULT 0
);

-- Retention holds only the state of now and cannot answer "what did I do on
-- Tuesday". Append-only, and every row is born with the local day already
-- resolved, on reviewed_day's scale.
CREATE TABLE event (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    entry_id    INTEGER NOT NULL REFERENCES entry(id) ON DELETE CASCADE,
    day         INTEGER NOT NULL,
    occurred_at INTEGER NOT NULL,
    type        TEXT NOT NULL, -- CAPTURED | CARD_READY | CORRECT | INCORRECT | LEVELED_UP
    -- Review number on CORRECT/INCORRECT, new level on LEVELED_UP. Null otherwise.
    detail      TEXT
);

CREATE INDEX event_day ON event(day DESC);
CREATE INDEX event_entry ON event(entry_id);

-- Informational, not a security quota: with no account it counts only what this
-- device generated.
CREATE TABLE ai_usage (
    month        TEXT NOT NULL PRIMARY KEY,
    generations  INTEGER NOT NULL DEFAULT 0
);

findEntryById:
SELECT * FROM entry_with_capture WHERE id = ?;

listEntriesByIds:
SELECT * FROM entry_with_capture WHERE id IN ? ORDER BY id;

listReady:
SELECT * FROM entry_with_capture WHERE status = 'READY' ORDER BY created_at DESC;

listInbox:
SELECT * FROM entry_with_capture WHERE status != 'READY' ORDER BY created_at ASC;

listAllEntries:
SELECT * FROM entry_with_capture ORDER BY created_at DESC, id DESC;

findCaptureById:
SELECT * FROM capture WHERE id = ?;

listPendingCaptures:
SELECT * FROM capture WHERE status != 'PROCESSED' ORDER BY created_at ASC;

listAllCaptures:
SELECT * FROM capture ORDER BY created_at DESC;

insertCapture:
INSERT INTO capture (
    snippet, source, created_at, status, format, media_path, duration_ms,
    transcription_error, native_language, target_language
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertedId:
SELECT last_insert_rowid();

insertEntry:
INSERT INTO entry (capture_id, target, start_index, end_index, type, status)
VALUES (?, ?, ?, ?, ?, ?);

recordTranscription:
UPDATE capture
SET snippet = ?, status = 'AWAITING_SELECTION', transcription_error = ?
WHERE id = ?;

processCapture:
UPDATE capture
SET snippet = ?, status = 'PROCESSED', transcription_error = NULL
WHERE id = ?;

-- Only before the capture becomes cards: after that the pair is written into
-- entries born in it.
changeCaptureLanguage:
UPDATE capture SET target_language = ? WHERE id = ? AND status != 'PROCESSED';

markStatus:
UPDATE entry SET status = ?, error_code = NULL, error_detail = NULL WHERE id = ?;

saveCard:
UPDATE entry
SET status = ?, type = ?, translation = ?, definitions_json = ?, example = ?,
    pronunciation = ?, related_json = ?, error_code = NULL, error_detail = NULL
WHERE id = ?;

markError:
UPDATE entry SET status = ?, error_code = ?, error_detail = ? WHERE id = ?;

deleteEntry:
DELETE FROM entry WHERE id = ?;

deleteEntriesOfCapture:
DELETE FROM entry WHERE capture_id = ?;

deleteCapture:
DELETE FROM capture WHERE id = ?;

countEntriesOfCapture:
SELECT count(*) FROM entry WHERE capture_id = ?;

listIdsOfCapture:
SELECT id FROM entry WHERE capture_id = ? ORDER BY id;

saveRetention:
UPDATE entry
SET points = ?, decay_rate = ?, last_interaction_at = ?,
    reviews = ?, correct_count = ?, incorrect_count = ?
WHERE id = ?;

localDay:
SELECT CAST(julianday((:instant + 0) / 1000, 'unixepoch', 'localtime') + 0.5 AS INTEGER);

localMonth:
SELECT strftime('%Y-%m', (:instant + 0) / 1000, 'unixepoch', 'localtime');

openDay:
INSERT OR IGNORE INTO reviewed_day (day, reviews) VALUES (?, 0);

addReview:
UPDATE reviewed_day SET reviews = reviews + 1 WHERE day = ?;

listReviewedDays:
SELECT day FROM reviewed_day ORDER BY day DESC LIMIT 400;

listActivitySince:
SELECT day, reviews FROM reviewed_day WHERE day >= ? ORDER BY day ASC;

openAiMonth:
INSERT OR IGNORE INTO ai_usage (month, generations) VALUES (?, 0);

addAiGeneration:
UPDATE ai_usage SET generations = generations + 1 WHERE month = ?;

observeAiUsageOfMonth:
SELECT generations FROM ai_usage WHERE month = ?;

recordEvent:
INSERT INTO event (entry_id, day, occurred_at, type, detail) VALUES (?, ?, ?, ?, ?);

-- Target and language ride along: the screen shows the word, not the id, and
-- filters by the open course.
listEventsSince:
SELECT
    ev.id,
    ev.entry_id,
    ev.day,
    ev.occurred_at,
    ev.type,
    ev.detail,
    e.target,
    c.native_language,
    c.target_language
FROM event ev
JOIN entry e ON e.id = ev.entry_id
JOIN capture c ON c.id = e.capture_id
WHERE ev.day >= ?
ORDER BY ev.day DESC, ev.occurred_at DESC, ev.id DESC;
