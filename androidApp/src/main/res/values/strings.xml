    <!--
      Timeline rows. The review line carries its number as an argument rather
      than building an ordinal in code: English wants "Review 2", Portuguese
      wants "2ª", and only the resource knows which.
    -->
    <string name="event_captured">captured</string>
    <string name="event_card_ready">card ready</string>
    <string name="event_review_correct">Review %1$d · correct</string>
