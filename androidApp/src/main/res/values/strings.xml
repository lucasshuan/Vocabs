    <string name="event_review_correct_unnumbered">review correct</string>
    <string name="event_review_incorrect_unnumbered">review incorrect</string>
    <!-- One key, not one per level: every level label is feminine in pt-BR. -->
    <string name="event_leveled_up">became %1$s</string>

