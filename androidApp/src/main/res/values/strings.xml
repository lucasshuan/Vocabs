    <string name="duplicate_status_pending">queued</string>
    <string name="duplicate_status_error">failed</string>

    <!--
      Relative time, backwards and forwards. Compact on purpose: these sit
      between middle dots in a one-line row, so "5 minutes ago" would not fit.
    -->
    <string name="time_now">now</string>
    <string name="time_minutes_ago">%1$dm ago</string>
    <string name="time_hours_ago">%1$dh ago</string>
    <string name="time_yesterday">yesterday</string>
    <string name="time_days_ago">%1$dd ago</string>
    <string name="time_in_minutes">in %1$dm</string>
    <string name="time_in_hours">in %1$dh</string>
    <string name="time_tomorrow">tomorrow</string>
    <plurals name="time_in_days">
        <item quantity="one">in %1$d day</item>
        <item quantity="other">in %1$d days</item>
    </plurals>
    <string name="review_now">review now</string>

    <!--
      Capture titles. Pasted text shows its own snippet rather than the word
      "Text": in a queue of five captures, "Text" three times distinguishes
      nothing. The quotation marks are a resource because they are typographic
      and differ by language.
    -->
    <string name="capture_audio">Audio</string>
    <string name="capture_audio_with_duration">Audio · %1$s</string>
    <string name="capture_photo">Photo</string>
    <string name="capture_photo_from">Photo from %1$s</string>
    <string name="capture_text">Text</string>
    <string name="capture_text_from">Text from %1$s</string>
    <string name="capture_text_quoted">“%1$s”</string>

