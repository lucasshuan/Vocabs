    <string name="entry_untitled_text">Untitled</string>

    <!-- Word vs phrase badge. Lower case: a classification, not a title. -->
    <string name="type_word">word</string>
    <string name="type_phrase">phrase</string>

    <!-- Duplicate notice -->
