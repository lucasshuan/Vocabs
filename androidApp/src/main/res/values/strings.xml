    <string name="level_new">new</string>
    <string name="level_learning">learning</string>
    <string name="level_familiar">familiar</string>
    <string name="level_mastered">mastered</string>

    <string name="back">Back</string>
    <string name="week_today">today</string>

    <!-- AI usage meter -->
    <string name="ai_usage_title">AI generations</string>
    <string name="ai_usage_detail">%1$d of %2$d this month</string>

    <!--
      Screen-reader text. Everything here describes something a sighted user
      reads from colour or position, so it carries state the visible label does
      not repeat.
    -->
    <string name="a11y_add_language">Add language</string>
    <string name="a11y_day_future">day %1$d, not here yet</string>
