<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the capture folder is exposed to the FileProvider, and only it.

  The camera app is another process and needs permission to write to the
  destination file. FileProvider grants that for one specific path, instead of
  passing a file:// URI around (which Android has blocked since 7 with
  FileUriExposedException).

  These paths must match ArquivosDeMidia.PASTA and the export folder in
  ExportadorVocabu; a mismatch throws on the first photo capture.
-->
<paths>
    <files-path name="captures" path="captures/" />
    <cache-path name="exports" path="exports/" />
</paths>
