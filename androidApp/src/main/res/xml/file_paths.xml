<?xml version="1.0" encoding="utf-8"?>
<!--
  Só a pasta das capturas fica exposta ao FileProvider, e só ela.

  O app da câmera é outro processo: ele precisa de permissão para escrever no
  arquivo de destino. O FileProvider concede isso para um caminho específico,
  em vez de a gente sair passando file:// (que o Android bloqueia desde a
  versão 7 com FileUriExposedException).
-->
<paths>
    <files-path name="capturas" path="capturas/" />
</paths>
