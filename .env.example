# Copy this file to .env (which is in .gitignore) and fill it in.
#    Copy-Item .env.example .env
#
# Environment variables take precedence over this file.

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret between the app and the server. Any string works — the app reads
# it from here at build time, so the two sides always match.
APP_TOKEN=change-me

# Optional, defaults to 8080.
# PORT=8080

# Which model generates the cards. Optional; the server has a default.
#
# Useful for comparing models without recompiling. There is also a per-run
# override that leaves this file alone:
#    .\gradlew.bat :server:run -PMODEL=claude-haiku-4-5
# MODEL=claude-opus-5

# Where the app looks for the server when it runs on a physical phone.
#
# Usually unnecessary: the build detects this machine's address on the local
# network by itself, and the emulator never uses it (there the address is always
# 10.0.2.2). Fill it in only if the detection guesses wrong, or if the server is
# on another machine.
# SERVER_LAN=192.168.0.15:8080
