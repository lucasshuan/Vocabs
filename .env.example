# Copie este arquivo para .env (que está no .gitignore) e preencha.
#    Copy-Item .env.example .env
#
# Variáveis de ambiente têm precedência sobre este arquivo.

# Chave da API da Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Segredo compartilhado entre o app e o servidor. Qualquer string serve — o app
# lê daqui na hora de compilar, então os dois lados sempre batem.
APP_TOKEN=troque-isto

# Opcional, padrão 8080.
# PORT=8080

# Onde o app encontra o servidor quando roda num celular físico.
#
# Normalmente não precisa: o build detecta sozinho o IP desta máquina na rede
# local, e no emulador nem é usado (lá o endereço é sempre 10.0.2.2). Preencha só
# se a detecção errar ou se o servidor estiver noutra máquina.
# SERVIDOR_LAN=192.168.0.15:8080
